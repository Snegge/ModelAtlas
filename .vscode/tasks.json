{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Model Atlas: backend",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "server/ModelAtlas.Api",
        "--urls",
        "http://127.0.0.1:5050"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Now listening on.*"
        }
      },
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Model Atlas: frontend",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*4200.*"
        }
      },
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Model Atlas: start both",
      "dependsOn": ["Model Atlas: backend", "Model Atlas: frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Model Atlas: client build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "problemMatcher": []
    },
    {
      "label": "Model Atlas: backend tests",
      "type": "shell",
      "command": "dotnet",
      "args": ["test", "server/ModelAtlas.Tests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Model Atlas: client tests",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "problemMatcher": []
    },
    {
      "label": "Model Atlas: validate",
      "dependsOn": [
        "Model Atlas: client build",
        "Model Atlas: backend tests",
        "Model Atlas: client tests"
      ],
      "problemMatcher": []
    }
  ]
}
